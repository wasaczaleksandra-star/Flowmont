{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "_shared/providers.ts",
    "_shared/processor.ts",
    "_shared/stripe.ts"
  ]
}
