{
  "expo": {
    "name": "Flowmont",
    "slug": "flowmont",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "flowmont",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EDF5FA",
    "ios": {
      "bundleIdentifier": "app.flowmont",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Flowmont potrzebuje dostępu do zdjęć, aby dodać je do zlecenia montażu.",
        "NSCameraUsageDescription": "Flowmont potrzebuje dostępu do aparatu, aby zrobić zdjęcie do zlecenia montażu."
      }
    },
    "android": {
      "package": "app.flowmont",
      "adaptiveIcon": {
        "backgroundColor": "#EDF5FA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Flowmont",
      "shortName": "Flowmont",
      "lang": "pl",
      "themeColor": "#00457F",
      "backgroundColor": "#EDF5FA"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDF5FA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Flowmont potrzebuje dostępu do zdjęć, aby dodać je do zlecenia montażu.",
          "cameraPermission": "Flowmont potrzebuje dostępu do aparatu, aby zrobić zdjęcie do zlecenia montażu."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
