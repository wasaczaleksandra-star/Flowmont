# Copy to .env.local (never commit real values). Only EXPO_PUBLIC_* values reach the app bundle
# and they are public by design – data is protected by row level security.

# Supabase → Project Settings → API (Project URL, publishable/anon key)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to true ONLY after Google is configured in Supabase → Authentication → Providers.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Set to true when Stripe secrets are set for the Edge Functions and plans exist in billing_plans.
EXPO_PUBLIC_BILLING_ENABLED=false

# ---------------------------------------------------------------------------------------------
# Server-side secrets: set them with `supabase secrets set …` (Edge Functions), NOT in this file
# for the app. Listed here for reference only.
# ---------------------------------------------------------------------------------------------
# APP_URL=https://app.example.pl              # public web address used in links and Stripe redirects
# EMAIL_PROVIDER=resend                       # resend | mock (default mock)
# RESEND_API_KEY=
# EMAIL_FROM="Flowmont <powiadomienia@example.pl>"
# SMS_PROVIDER=smsapi                         # smsapi | twilio | mock (default mock)
# SMSAPI_TOKEN=
# SMS_SENDER_NAME=Flowmont
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# STRIPE_SECRET_KEY=sk_test_...               # test mode only unless STRIPE_ALLOW_LIVE=true
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_ALLOW_LIVE=false

# Demo seed (scripts/seed-demo.mjs) – run from a trusted machine only
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
